{
  "name": "pi-better-read-aloud",
  "version": "0.1.0",
  "description": "OpenAI-compatible text-to-speech read-aloud tools for Pi.",
  "type": "module",
  "keywords": [
    "pi-extension",
    "tts",
    "read-aloud"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/1aboveio/pi-better-harness/main/docs/images/package-gallery/pi-better-read-aloud.png"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "README.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "typebox": "^1.1.38"
  }
}