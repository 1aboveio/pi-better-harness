{
  "name": "pi-better-harness",
  "version": "0.45.2",
  "description": "Pi extension bundle for a write sandbox, subagents, background tasks, SSH, goals, model routing, and Outcome & Todo.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-better-harness",
    "sandbox",
    "subagents",
    "background-tasks",
    "ssh",
    "remote-bash",
    "goal-tracking",
    "todo-tracking"
  ],
  "pi": {
    "extensions": [
      "extensions/sandbox/index.ts",
      "extensions/subagents/index.ts",
      "extensions/background-tasks/index.ts",
      "extensions/ssh/index.ts",
      "extensions/goal/index.ts",
      "extensions/model-router/index.ts",
      "extensions/task-context/index.ts",
      "extensions/project-context/index.ts",
      "extensions/minimal-output/index.ts",
      "extensions/tool-call-guard/index.ts",
      "extensions/settings/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/1aboveio/pi-better-harness/main/docs/images/package-gallery/pi-better-harness.png"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1aboveio/pi-better-harness.git",
    "directory": "packages/pi-better-harness"
  },
  "bugs": {
    "url": "https://github.com/1aboveio/pi-better-harness/issues"
  },
  "homepage": "https://github.com/1aboveio/pi-better-harness/tree/main/packages/pi-better-harness#readme",
  "bin": {
    "pi-better-harness": "bin/pi-better-harness.mjs",
    "pi-agent-catalog": "bin/pi-agent-catalog.mjs"
  },
  "files": [
    "README.md",
    "CHANGELOG.md",
    "bin/*.mjs",
    "lib/*.mjs",
    "extensions/**/*.ts"
  ],
  "scripts": {
    "prepack": "node ../../scripts/generate-harness-changelog.mjs && node ../../scripts/sync-shared-log-utils.mjs && node ../../scripts/stage-harness-dependencies.mjs",
    "typecheck": "tsc --noEmit --allowImportingTsExtensions --module NodeNext --moduleResolution NodeNext --target ES2022 --strict --skipLibCheck --types node extensions/minimal-output/index.ts extensions/minimal-output/hook.ts extensions/settings/index.ts extensions/execution-policy.ts extensions/worktree-context.ts extensions/project-context/index.ts extensions/tool-call-guard/index.ts extensions/tool-call-guard/waits.ts extensions/task-context/index.ts",
    "test": "node --import tsx --import ../../scripts/isolate-registry.mjs --test test/*.test.mjs test/*.test.ts test/task-context/*.test.ts"
  },
  "dependencies": {
    "pi-better-background-tasks": "0.15.1",
    "pi-better-goal": "0.13.1",
    "pi-better-model-router": "0.1.4",
    "pi-ollama-cloud": "0.13.1",
    "pi-better-sandbox": "0.14.1",
    "pi-better-ssh": "0.1.5",
    "pi-better-subagents": "0.32.1",
    "proper-lockfile": "^4.1.2",
    "shell-quote": "1.12.0",
    "smol-toml": "1.9.0",
    "tsx": "^4.22.3",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@sinclair/typebox": "*"
  },
  "bundledDependencies": [
    "pi-better-background-tasks",
    "pi-better-goal",
    "pi-better-model-router",
    "pi-better-sandbox",
    "pi-better-ssh",
    "pi-better-subagents"
  ]
}
