{
  "name": "pi-better-model-router",
  "version": "0.1.0",
  "description": "Price-aware virtual model routing for Pi.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "model-routing"
  ],
  "pi": {
    "extensions": [
      "./node_modules/pi-ollama-cloud/index.ts",
      "./src/index.ts"
    ]
  },
  "files": [
    "scripts/*.mjs",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "README.md"
  ],
  "scripts": {
    "prepack": "node scripts/stage-dependencies.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "bundledDependencies": [
    "pi-ollama-cloud"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/1aboveio/pi-better-harness.git",
    "directory": "packages/pi-better-model-router"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.52",
    "pi-ollama-cloud": "0.13.1"
  },
  "bundleDependencies": [
    "pi-ollama-cloud"
  ]
}
